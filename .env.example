# Copy to .env (which git ignores) and fill in. Used by docker-compose.yml.
# Generate each secret with: openssl rand -hex 32

# Password for the bundled PostgreSQL database.
POSTGRES_PASSWORD=

# Signs everyone's sign-ins. Required; at least 32 characters. Keep it stable: changing it signs everyone out.
JWT_SECRET=

# Encrypts the SMTP password saved in Admin Panel -> Email and webhooks' signing secrets. At least 32
# characters. Optional, but without it no mail password can be saved and no webhook created. Keep it
# stable: changing it means re-entering that password and rotating webhook secrets.
SECRETS_KEY=

# The first admin's password (username: admin), used only when the database has no users yet.
# Leave empty to have a random one printed once in the log (`docker compose logs tessick`),
# which must then be changed at first sign-in.
ADMIN_PASSWORD=

# Set to true when Tessick runs behind a reverse proxy (nginx, Caddy, Traefik, a load balancer).
TRUST_PROXY=false

# true lets webhooks reach localhost and link-local addresses (refused otherwise). Private-network
# addresses (10.x, 192.168.x, ...) work either way.
WEBHOOK_ALLOW_LOCAL=false

# Evidence (screenshots, videos, logs uploaded for test executions). By default they're kept on
# the evidence-data volume. Back it up with the database.
# EVIDENCE_MAX_FILE_MB=200
#
# Or keep them in S3 or an S3-compatible store (MinIO, Cloudflare R2): set EVIDENCE_STORAGE=s3 and
# the bucket. EVIDENCE_S3_ENDPOINT is for S3-compatible stores (usually with
# EVIDENCE_S3_FORCE_PATH_STYLE=true). EVIDENCE_S3_SSE=AES256 or aws:kms asks for encryption at rest.
# The AWS keys can be left empty when the server has an IAM role.
# EVIDENCE_STORAGE=s3
# EVIDENCE_S3_BUCKET=
# EVIDENCE_S3_REGION=
# EVIDENCE_S3_ENDPOINT=
# EVIDENCE_S3_PREFIX=
# EVIDENCE_S3_FORCE_PATH_STYLE=false
# EVIDENCE_S3_SSE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Port on this machine.
TESSICK_PORT=3001
